{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "paper-check venue profile",
  "type": "object",
  "required": ["id", "name", "publisher", "group", "checked_on", "sources", "rules"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "name": {"type": "string", "minLength": 3},
    "abbreviation": {"type": "string"},
    "publisher": {"type": "string"},
    "group": {"enum": ["general-top5", "general", "field"]},
    "checked_on": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "notes": {"type": "string"},
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "url", "title", "access"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
          "url": {"type": "string", "pattern": "^https?://"},
          "title": {"type": "string"},
          "access": {"enum": ["read", "blocked", "search_summary"]},
          "note": {"type": "string"}
        }
      }
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "abstract_max_words": {"$ref": "#/$defs/rule"},
        "manuscript_limit": {"$ref": "#/$defs/rule"},
        "keywords": {"$ref": "#/$defs/rule"},
        "jel_codes": {"$ref": "#/$defs/rule"},
        "highlights": {"$ref": "#/$defs/rule"},
        "review_type": {"$ref": "#/$defs/rule"},
        "disclosure_statement": {"$ref": "#/$defs/rule"},
        "data_availability_statement": {"$ref": "#/$defs/rule"},
        "data_code_policy": {"$ref": "#/$defs/rule"},
        "ethics_approval": {"$ref": "#/$defs/rule"},
        "trial_registration": {"$ref": "#/$defs/rule"},
        "deception": {"$ref": "#/$defs/rule"},
        "experiment_materials": {"$ref": "#/$defs/rule"},
        "ai_use": {"$ref": "#/$defs/rule"},
        "citation_style": {"$ref": "#/$defs/rule"},
        "submission_fee": {"$ref": "#/$defs/rule"},
        "file_format": {"$ref": "#/$defs/rule"},
        "other": {
          "type": "array",
          "items": {
            "allOf": [
              {"$ref": "#/$defs/rule"},
              {"type": "object", "required": ["name"], "properties": {"name": {"type": "string"}}}
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "name": {"type": "string"},
        "status": {"enum": ["confirmed", "unconfirmed", "not_stated"]},
        "value": {},
        "source": {"type": "string"},
        "quote": {"type": "string"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    }
  }
}
